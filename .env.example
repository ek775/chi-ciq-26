HF_TOKEN=your-hugging-face-token
TRANSCRIPTION_INPUT_DIR=data/mp4
TRANSCRIPTION_OUTPUT_DIR=data/database
POSTGRES_PASSWORD=replace-with-a-local-development-password
# For Python running on the host; inside Compose, DATABASE_URL is set automatically.
DATABASE_URL=postgresql+psycopg://transcription:replace-with-a-local-development-password@localhost:5433/transcription