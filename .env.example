HF_TOKEN=your-hugging-face-token
# Python application logging: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO
TRANSCRIPTION_INPUT_DIR=data/mp4
# Dispatcher runs on the submitter; workers use the image and assigned file only.
TRANSCRIPTION_WORKER_IMAGE=docker://your-registry/chi-ciq-transcription:commit-tag
# Optional remote directory of already-published MP4s (never credentials).
# Leave empty when the cluster template mounts shared input storage.
TRANSCRIPTION_INPUT_BASE_URI=
FUZZBALL_BIN=fuzzball
POSTGRES_PASSWORD=replace-with-a-local-development-password
WEB_POSTGRES_PASSWORD=replace-with-a-separate-web-database-password
DOCUMENTS_POSTGRES_PASSWORD=replace-with-a-separate-documents-database-password
DOCUMENTS_INPUT_DIR=./data-reference
# Used by host document commands; container jobs set this automatically.
DOCUMENTS_DATABASE_URL=postgresql+psycopg://documents:replace-with-a-separate-documents-database-password@localhost:5434/documents
ANALYTICS_POSTGRES_PASSWORD=replace-with-a-separate-analytics-database-password
ANALYTICS_WEB_POSTGRES_PASSWORD=replace-with-a-separate-dashboard-reader-password
# Directory mounted at /inputs for roster.csv and speaker-labels.csv.
ANALYTICS_INPUT_DIR=./data/analytics
# Used by host analytics commands; container jobs set these automatically.
ANALYTICS_DATABASE_URL=postgresql+psycopg://analytics:replace-me@localhost:5435/analytics
# Read-only source for analytics; falls back to DATABASE_URL when unset.
MEETINGS_DATABASE_URL=
# Fuzzball requires separate SELECT-only reader URLs; no owner fallback.
DOCUMENTS_READER_DATABASE_URL=
ANALYTICS_READER_DATABASE_URL=
# OpenAI-compatible vLLM endpoint and served model name for stance analysis.
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_SERVED_MODEL=local-ai
VLLM_API_KEY=
# Reasoning effort sent as chat_template_kwargs (low|high|max for GLM-5.3);
# leave empty for models without it. Thinking tokens are added to max_tokens.
VLLM_REASONING_EFFORT=low
VLLM_REASONING_TOKENS=4096
# Optional, separate vLLM service (docker compose --profile ai up -d vllm).
# GLM-5.3-Flash (MIT, 321B MoE / 18B active) needs ~306 GiB of GPU memory for
# its FP8 weights, e.g. 8x H100/H200 (tensor parallel 8) or 4x H200/GB200.
# Single-GPU alternatives: zai-org/GLM-4.7-Flash (keep the glm47 parser), or
# Qwen/Qwen2.5-0.5B-Instruct with VLLM_EXTRA_ARGS= and VLLM_REASONING_EFFORT=.
VLLM_MODEL=zai-org/GLM-5.3-Flash
VLLM_MAX_MODEL_LEN=32768
VLLM_GPU_MEMORY_UTILIZATION=0.9
VLLM_TENSOR_PARALLEL_SIZE=8
VLLM_EXTRA_ARGS=--reasoning-parser glm47
# For Python running on the host; inside Compose, DATABASE_URL is set automatically.
DATABASE_URL=postgresql+psycopg://transcription:replace-with-a-local-development-password@localhost:5433/transcription