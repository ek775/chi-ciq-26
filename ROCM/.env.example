# Local AMD Linux host only; keep separate from the root/Fuzzball environment.
HF_TOKEN=
# URL-safe password, used only by these isolated development databases.
ROCM_POSTGRES_PASSWORD=
# stat -c %g /dev/dri/renderD128
ROCM_RENDER_GID=
ROCM_RENDER_DEVICE=/dev/dri/renderD128
# ROCm ordinal of the GPU matching the render device above.
ROCM_VISIBLE_DEVICE=0
ROCM_AUDIO_COUNT=10
ROCM_DOWNLOAD_WORKERS=2
ROCM_DOCUMENT_COUNT=3
ROCM_STANCE_LIMIT=20
# Tiny integration model, not a policy-quality or production model.
ROCM_VLLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
ROCM_WEB_PORT=18080
LOG_LEVEL=INFO
